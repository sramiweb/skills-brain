{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills Brain Evaluation Runner Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_by", "generated_at", "results"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "generated_by": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "runtime": {"type": "string"},
    "model": {"type": "string"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["completed", "error", "skipped"]},
          "output_summary": {"type": "string"},
          "artifact_refs": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "error": {"type": "string"}
        }
      }
    }
  }
}
