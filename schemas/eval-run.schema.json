{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills Brain Evaluation Run Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "gate", "skill", "definition", "generated_at", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "gate": {"type": "string", "enum": ["Q4", "Q5"]},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "package_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "input", "checks", "forbidden"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["golden_task", "regression_check"]},
          "input": {"type": "object"},
          "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "forbidden": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
