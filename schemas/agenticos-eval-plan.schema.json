{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/agenticos-eval-plan.schema.json",
  "title": "Skills Brain AgenticOS Evaluation Plan v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "gate", "skill", "runtime", "jobs", "authorization"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "gate": {"type": "string", "enum": ["Q4", "Q5"]},
    "authorization": {"const": "not_granted"},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "package_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "tenant", "agent", "data_class"],
      "properties": {
        "platform": {"const": "agenticos"},
        "tenant": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "data_class": {"type": "string", "enum": ["S0", "S1", "S2", "S3"]},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "prompt", "package_context", "expected_upstream"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["golden_task", "regression_check"]},
          "prompt": {"type": "string", "minLength": 1},
          "package_context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "read_only", "include", "max_bytes"],
            "properties": {
              "mode": {"const": "installed_skill_package"},
              "read_only": {"const": true},
              "include": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}
            }
          },
          "expected_upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "package_sha256"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
            }
          }
        }
      }
    }
  }
}
