{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills Brain Independent Evaluation Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "verified_by", "verification_type", "generated_at", "independent", "results"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "verified_by": {"type": "string", "minLength": 1},
    "verification_type": {"type": "string", "enum": ["deterministic", "human", "independent_model"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "independent": {"type": "boolean"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected_match", "criteria_checks", "forbidden_checks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "expected_match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "evidence"],
            "properties": {
              "passed": {"type": "boolean"},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "criteria_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "passed", "evidence"],
              "properties": {
                "criterion": {"type": "string", "minLength": 1},
                "passed": {"type": "boolean"},
                "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "forbidden_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "triggered", "evidence"],
              "properties": {
                "rule": {"type": "string", "minLength": 1},
                "triggered": {"type": "boolean"},
                "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
