{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/agenticos-export.schema.json",
  "title": "Skills Brain AgenticOS Export Contract v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source", "skill", "governance", "integrity"],
  "properties": {
    "contract_version": {"enum": ["1.0", "1.1"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "path": {"type": "string", "pattern": "^skills/"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "description", "capabilities", "requirements", "contracts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {"type": "array", "items": {"type": "object"}},
            "outputs": {"type": "array", "items": {"type": "object"}}
          }
        },
        "compatibility": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "side_effects", "security", "evaluation"],
      "properties": {
        "risk": {"type": "object"},
        "side_effects": {"type": "string"},
        "security": {"type": "object"},
        "data_classes": {"type": "object"},
        "evaluation": {"type": "object"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_sha256", "manifest_sha256", "package_sha256"],
      "properties": {
        "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
