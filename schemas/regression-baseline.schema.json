{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/regression-baseline.schema.json",
  "title": "Skills Brain Verified Regression Baseline v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "subject", "generated_at", "generated_by", "verified", "verification", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "version"],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {"type": "string", "minLength": 1},
    "verified": {"const": true},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "verified_by", "independent"],
      "properties": {
        "type": {"type": "string", "enum": ["deterministic", "human", "independent_model"]},
        "verified_by": {"type": "string", "minLength": 1},
        "independent": {"const": true}
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "evidence_refs"],
        "properties": {
          "value": {"type": "number"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
