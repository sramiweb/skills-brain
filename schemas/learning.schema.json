{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/learning.schema.json",
  "title": "Skills Brain Learning Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "learning_id", "maturity", "statement", "evidence_refs", "confidence", "scope"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "learning_id": {"type": "string", "minLength": 1},
    "maturity": {"type": "string", "enum": ["signal", "pattern", "hypothesis", "verified_learning", "operationalized_knowledge"]},
    "statement": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "enum": ["execution", "incident", "campaign", "release", "customer", "experiment", "debate", "human_feedback", "evaluation"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {"type": "string"},
        "domain": {"type": "string"},
        "tenant_hash": {"type": "string"},
        "segment": {"type": "string"},
        "channel": {"type": "string"}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "sample_count": {"type": "integer", "minimum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "last_verified": {"type": ["string", "null"], "format": "date-time"},
    "recommended_action": {"type": "string"},
    "generic_candidate": {"type": "boolean"}
  }
}
