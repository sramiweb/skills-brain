{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/resolution-request.schema.json",
  "title": "Skills Brain Resolution Request v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities", "available_tool_capabilities", "allowed_status", "max_risk"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "available_tool_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_status": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["draft", "review", "candidate", "approved", "active", "deprecated"]
      }
    },
    "max_risk": {"type": "integer", "minimum": 0, "maximum": 4},
    "data_class": {"type": "string", "enum": ["S0", "S1", "S2", "S3"]},
    "allow_unspecified_data_class": {"type": "boolean"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"},
        "require_explicit_compatibility": {"type": "boolean"}
      }
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "include_rejected": {"type": "boolean"},
    "evaluation_report": {"type": "string", "minLength": 1}
  }
}
