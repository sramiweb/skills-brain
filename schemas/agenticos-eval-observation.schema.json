{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/agenticos-eval-observation.schema.json",
  "title": "Skills Brain AgenticOS Evaluation Observation v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "generated_by", "generated_at", "runtime", "executions"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "generated_by": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": {"const": "agenticos"},
        "version": {"type": "string"},
        "host_ref": {"type": "string"}
      }
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "exec_id", "status", "upstream_skill"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "exec_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["succeeded", "failed", "timeout", "cancelled", "skipped"]},
          "output": {"type": "string"},
          "error": {"type": "string"},
          "model_used": {"type": "string"},
          "data_class": {"type": "string", "enum": ["S0", "S1", "S2", "S3"]},
          "effective_allowed_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "artifact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "upstream_skill": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "package_sha256"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
