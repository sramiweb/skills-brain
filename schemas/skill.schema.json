{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/skill.schema.json",
  "title": "Skills Brain Skill Manifest v2.1",
  "description": "Canonical strict schema for Skills Brain skill.yaml manifests. Runtime-specific bindings belong to AgenticOS, not to canonical skills.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "description",
    "capabilities",
    "risk",
    "side_effects",
    "security",
    "evaluation",
    "ownership",
    "provenance"
  ],
  "$defs": {
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_id", "source", "required", "allowed_data_classes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "schema_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "source": {"type": "string", "enum": ["mission", "skill", "either"]},
        "required": {"type": "boolean"},
        "from_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}
        },
        "allowed_data_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["S0", "S1", "S2", "S3"]}
        },
        "description": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "skill"}}, "required": ["source"]},
          "then": {"required": ["from_capabilities"]}
        }
      ]
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_id", "data_class"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "schema_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "data_class": {"type": "string", "enum": ["S0", "S1", "S2", "S3"]},
        "description": {"type": "string"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "description": "Legacy or external identifiers accepted only for migration/resolution. The canonical id remains authoritative."
    },
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "status": {"type": "string", "enum": ["draft", "review", "candidate", "approved", "active", "deprecated", "retired", "quarantined"]},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}
    },
    "inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input_contract"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/output_contract"}}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}, "uniqueItems": true},
        "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {"type": "integer", "minimum": 0, "maximum": 4},
        "description": {"type": "string"}
      }
    },
    "side_effects": {"type": "string", "enum": ["none", "local", "reversible", "external", "destructive"]},
    "data_classes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string", "enum": ["S0", "S1", "S2", "S3"]}, "uniqueItems": true}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "shell", "destructive_operations"],
      "properties": {
        "network": {"type": "object", "additionalProperties": false, "required": ["outbound"], "properties": {"outbound": {"type": "boolean"}}},
        "filesystem": {"type": "object", "additionalProperties": false, "required": ["read", "write"], "properties": {"read": {"type": "boolean"}, "write": {"type": "boolean"}}},
        "shell": {"type": "boolean"},
        "destructive_operations": {"type": "boolean"},
        "credentials": {"type": "object", "additionalProperties": false, "properties": {"required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "optional": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "extends": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "composes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "related": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["golden_tasks", "minimum_score"],
      "properties": {
        "golden_tasks": {"type": "string", "enum": ["required", "optional", "none"]},
        "minimum_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maintainer"],
      "properties": {"maintainer": {"type": "string", "minLength": 1}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {"type": "string", "enum": ["skills-brain", "external"]},
        "author": {"type": "string"},
        "source_repository": {"type": "string"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "derived_from": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "license": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "last_review": {"type": "string", "format": "date-time"}
      }
    },
    "compatibility": {"type": "object", "additionalProperties": {"type": "string"}},
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {"supported": {"type": "boolean"}, "key_strategy": {"type": "string"}}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
