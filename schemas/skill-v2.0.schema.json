{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/skill-v2.0.schema.json",
  "title": "Skills Brain Skill Manifest v2.0 Compatibility Schema",
  "description": "Compatibility schema for manifests created during the v2.0 migration. New skills should use schema_version 2.1 and schemas/skill.schema.json.",
  "type": "object",
  "required": ["schema_version", "id", "version", "status", "capabilities"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
    "status": {"type": "string", "enum": ["draft", "review", "candidate", "approved", "active", "deprecated", "retired", "quarantined"]},
    "description": {"type": "string"},
    "category": {"type": "string"},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "object"},
    "permissions": {"type": "object"},
    "side_effects": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}}
      ]
    },
    "risk": {"type": "object"},
    "data_classes": {"type": "object"},
    "dependencies": {"type": "object"},
    "relationships": {"type": "object"},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "evaluation": {"type": "object"},
    "ownership": {"type": "object"},
    "provenance": {"type": "object"},
    "compatibility": {"type": "object"},
    "security": {"type": "object"},
    "idempotency": {"type": "object"},
    "integrity": {"type": "object"}
  },
  "additionalProperties": true
}
