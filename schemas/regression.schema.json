{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills Brain Regression Definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "allowed_delta"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "allowed_delta": {"type": "number"},
          "direction": {"type": "string", "enum": ["higher-is-better", "lower-is-better", "no-change"]}
        }
      }
    }
  }
}
