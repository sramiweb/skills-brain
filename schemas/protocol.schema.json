{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sramiweb/skills-brain/main/schemas/protocol.schema.json",
  "title": "Skills Brain Deliberation Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "type", "purpose", "roles", "rounds", "rules", "limits", "verdicts", "human_approval"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "type": {"const": "deliberation"},
    "purpose": {"type": "string", "minLength": 1},
    "roles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "blind"],
        "properties": {
          "id": {"type": "string"},
          "blind": {"type": "boolean"}
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_required", "preserve_dissent", "majority_vote_allowed", "proposer_may_judge", "security_veto_overrides", "pre_mortem"],
      "properties": {
        "evidence_required": {"type": "boolean"},
        "preserve_dissent": {"type": "boolean"},
        "majority_vote_allowed": {"type": "boolean"},
        "proposer_may_judge": {"type": "boolean"},
        "security_veto_overrides": {"type": "boolean"},
        "pre_mortem": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rounds", "max_participants"],
      "properties": {
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_participants": {"type": "integer", "minimum": 2, "maximum": 8}
      }
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["support", "support_with_conditions", "reject", "insufficient_evidence", "escalate"]}
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {"type": "string", "enum": ["required", "conditional", "none"]},
        "destructive_actions": {"type": "string", "enum": ["required", "conditional", "none"]}
      }
    }
  }
}
